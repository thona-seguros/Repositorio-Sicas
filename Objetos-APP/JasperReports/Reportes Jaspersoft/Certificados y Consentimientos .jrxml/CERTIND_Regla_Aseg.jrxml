	<parameter name="IDPOLIZA" class="java.lang.String"/>
	<parameter name="IDETPOLINI" class="java.lang.String"/>
	<parameter name="IDETPOLFIN" class="java.lang.String"/>
	<parameter name="CODASEG" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[--CERTIFICADO
SELECT
    PO.CODAGRUPADOR,
    TO_CHAR(PN.FECINGRESO,'DD/MM/YYYY') AS FECINGRESO,
    (PO.FECFINVIG - PO.FECINIVIG) DIAS_VIGENCIA,
    DECODE(PO.INDFACTURAPOL,'N',
           OC_ASEGURADO.NOMBRE_ASEGURADO(DP.CODCIA, DP.CODEMPRESA, DP.COD_ASEGURADO),
           OC_CLIENTES.NOMBRE_CLIENTE(PO.CODCLIENTE)) NOM_CLIENTE, 
    PN.NUM_DOC_IDENTIFICACION,
    PO.HORAVIGINI,
    PO.HORAVIGFIN,
    OC_ASEGURADO.DIRECCION_ASEGURADO(DP.CODCIA, DP.CODEMPRESA, DP.COD_ASEGURADO) DIR_CLIENTE,
    PO.CODCIA,
    PO.CODEMPRESA,
    LPAD(PO.CODCLIENTE,10,'0') CODCLIENTE, 
    PO.IDPOLIZA,
    TO_CHAR(PO.FECINIVIG,'DD/MM/YYYY') AS FECINIVIG,
    TO_CHAR(PO.FECFINVIG,'DD/MM/YYYY') AS FECFINVIG,
    PO.CODPLANPAGO,
    PO.NUMPOLUNICO,
     TO_CHAR(PO.FECEMISION,'DD/MM/YYYY') AS FECEMISION,
    OC_MONEDA.MONEDA_ALTERNA(PO.COD_MONEDA) MONEDA,
    PO.NUMPOLREF,
    PN.TIPO_ID_TRIBUTARIA,
    --PN.NUM_TRIBUTARIO,
    OC_CLIENTES.NUM_DOC_IDENTIFICACION(PO.CODCLIENTE) AS NUM_TRIBUTARIO,
    OC_REGISTRO_TIPSEG_AUTORIDAD.NUMERO_AUTORIZACION(DP.IDTIPOSEG, 1,1, PO.FECINIVIG, PO.FECFINVIG) AS NUMERO_AUTORIZACION,
    TO_CHAR(PN.FECINGRESO,'DD/MM/YYYY') AS FECINGRESO,
    OC_REGISTRO_TIPSEG_AUTORIDAD.NUMERO_AUTORIZACION(DP.IDTIPOSEG, 1,1, PO.FECINIVIG, PO.FECFINVIG) AS NUMERO_AUTORIZACION,
    DP.IDETPOL,
    ASE.COD_ASEGURADO,
    ASEG.CAMPO3,
    TO_CHAR(PN.FECINGRESO,'DD/MM/YYYY') AS FECINGRESO,              
    OC_ASEGURADO.EDAD_ASEGURADO(DP.CODCIA, DP.CODEMPRESA, ASEG.COD_ASEGURADO, TRUNC(SYSDATE)) EDAD,
    TO_CHAR(PN.FECNACIMIENTO,'DD/MM/YYYY') AS FECNACIMIENTO,
    PN.SEXO, 
    OC_PERSONA_NATURAL_JURIDICA.NOMBRE_PERSONA(ASEG.COD_ASEGURADO) NOMASEG,
    DP.CODPLANPAGO,
    DP.FECINIVIG,
    DP.FECFINVIG, 
    DP.IDTIPOSEG, 
    OC_TIPOS_DE_SEGUROS.TIPO_DE_SEGURO(DP.CODCIA, DP.CODEMPRESA, DP.IDTIPOSEG) TIPO_SEGURO,
    DP.PLANCOB,
    DP.TASA_CAMBIO,
    DP.PORCCOMIS, 
    ASEG.IDENDOSO,
    CLAUSULAS.DESC_CLAU,
    OC_VALORES_DE_LISTAS.BUSCA_LVALOR('CODRAMOS', TS.CODTIPOPLAN) AS RAMO, --AGREGADO
       OC_VALORES_DE_LISTAS.BUSCA_LVALOR('SUBRAMOS', PC.CODTIPOPLAN) AS SUB_RAMO, --AGREGADO
       AG.COD_AGENTE AS AGENTE, --AGREGADO
       PG.DESCPLAN AS FORMA_PAGO, --AGREGADO
       TO_CHAR(PO.FECEMISION,'DD/MM/YYYY') AS FECHA_ALTA, --AGREGADO
       TO_CHAR(OC_REGISTRO_TIPSEG_AUTORIDAD.FECHA_AUTORIZACION(DP.IDTIPOSEG, 1,1, PO.FECINIVIG, PO.FECFINVIG), 'DD') || ' de ' || 
	    INITCAP(RTRIM(TO_CHAR(OC_REGISTRO_TIPSEG_AUTORIDAD.FECHA_AUTORIZACION(DP.IDTIPOSEG, 1,1, PO.FECINIVIG, PO.FECFINVIG), 'Month', 'NLS_DATE_LANGUAGE=SPANISH'))) || ' de ' || 
		TO_CHAR(OC_REGISTRO_TIPSEG_AUTORIDAD.FECHA_AUTORIZACION(DP.IDTIPOSEG, 1,1, PO.FECINIVIG, PO.FECFINVIG), 'YYYY') AS FECHA_AUTORIZACION,
		CASE WHEN TS.CODTIPOPLAN = '010' THEN ' ' ELSE 'THONA SEGUROS, S. A. de C. V., cubre al asegurado citado y lo protege de acuerdo a las condiciones generales y endosos de este contrato, conforme las coberturas
enumeradas y sumas aseguradas respectivas, siempre que el accidente se manifieste dentro de la vigencia de la póliza y no esté excluido en las estipulaciones del contrato.'
END AS LEYENDA_AP,   
    (SELECT OC_ADICIONALES_EMPRESA.TEXTO_PIE_PAGINA(1) 
    FROM DUAL) PIE_PAGINA
FROM ASEGURADO_CERTIFICADO ASEG
INNER JOIN ASEGURADO ASE ON ASEG.COD_ASEGURADO = ASE.COD_ASEGURADO
INNER JOIN DETALLE_POLIZA DP ON ASEG.IDPOLIZA = DP.IDPOLIZA 
    AND ASEG.IDETPOL = DP.IDETPOL 
    AND ASEG.CODCIA = DP.CODCIA
INNER JOIN TIPOS_DE_SEGUROS TS ON DP.IDTIPOSEG = TS.IDTIPOSEG --AGREGADO
INNER JOIN PLAN_COBERTURAS PC ON PC.IDTIPOSEG = DP.IDTIPOSEG AND PC.PLANCOB = DP.PLANCOB
INNER JOIN AGENTE_POLIZA AG ON DP.IDPOLIZA = AG.IDPOLIZA --AGREGADO
INNER JOIN AGENTES_DETALLES_POLIZAS ADP ON DP.IDPOLIZA = ADP.IDPOLIZA --AGREGADO
    AND AG.COD_AGENTE = ADP.COD_AGENTE AND ASEG.IDETPOL = ADP.IDETPOL 
INNER JOIN POLIZAS PO ON DP.IDPOLIZA = PO.IDPOLIZA 
    AND DP.CODCIA = PO.CODCIA
INNER JOIN PLAN_DE_PAGOS PG ON PO.CODPLANPAGO = PG.CODPLANPAGO --AGREGADO
INNER JOIN PERSONA_NATURAL_JURIDICA PN ON ASE.TIPO_DOC_IDENTIFICACION = PN.TIPO_DOC_IDENTIFICACION 
    AND ASE.NUM_DOC_IDENTIFICACION = PN.NUM_DOC_IDENTIFICACION
LEFT JOIN (
    SELECT MAX(DescClau) DESC_CLAU
    FROM (
        SELECT DISTINCT SYS.STRAGG(OC_VALORES_DE_LISTAS.BUSCA_LVALOR('TIPCLAUS', CD.Tipo_Clausula) || ' - ') DescClau
        FROM CLAUSULAS_DETALLE CD
        JOIN POLIZAS PO ON CD.IdPoliza = PO.IdPoliza
        WHERE PO.CodCia = 1 AND PO.IdPoliza = $P{IDPOLIZA} 
        UNION
        SELECT DISTINCT SYS.STRAGG(OC_VALORES_DE_LISTAS.BUSCA_LVALOR('TIPCLAUS', CD.Tipo_Clausula) || ' - ') DescClau
        FROM CLAUSULAS_POLIZA CD
        JOIN POLIZAS PO ON CD.IdPoliza = PO.IdPoliza
        WHERE PO.CodCia = 1 AND PO.IdPoliza = $P{IDPOLIZA}      
    )
) CLAUSULAS ON 1 = 1
WHERE  DP.IDetPol >= $P{IDETPOLINI} 
  AND DP.IDetPol <= $P{IDETPOLFIN} 
  AND PO.IDPOLIZA = $P{IDPOLIZA} 
  AND ADP.IND_PRINCIPAL = 'S'
  AND ASE.COD_ASEGURADO = $P{CODASEG} 
  ORDER BY DP.IDETPOL, ASE.COD_ASEGURADO]]>
	</queryString>
