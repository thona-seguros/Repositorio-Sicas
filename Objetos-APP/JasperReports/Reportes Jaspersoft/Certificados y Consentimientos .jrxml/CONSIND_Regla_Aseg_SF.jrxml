	<subDataset name="ASEGURADOS" uuid="912e7279-ebc4-4a2f-be1d-4aa14f8fe61a">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataSource SICASPRD PROD"/>
		<parameter name="IDPOLIZA" class="java.lang.String"/>
		<parameter name="CODCIA" class="java.lang.String"/>
		<parameter name="IDETPOL" class="java.lang.String"/>
		<parameter name="COD_ASEGURADO" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT CBA.CODCIA, CBA.COD_ASEGURADO, CBA.CODEMPRESA, CBA.IDPOLIZA, CBA.IDETPOL, CBA.CODCOBERT, CBA.PLANCOB, CBA.IDTIPOSEG, 
RSA.TEXTO SUMAASEG_MONEDA,
RSA.TEXTO AS SUMAASEG_LOCAL,
CBA.PRIMA_MONEDA, CBA.PRIMA_LOCAL, DEDUCIBLE_LOCAL,
OC_COBERTURAS_DE_SEGUROS.DESCRIPCION_COBERTURA(CBA.CODCIA, CBA.CODEMPRESA, CBA.IDTIPOSEG, CBA.PLANCOB, CBA.CODCOBERT) NOMBRECOBERTURA, ORDENIMPRESION
FROM COBERT_ACT_ASEG CBA
INNER JOIN COBERTURAS_DE_SEGUROS CS ON CS.CODCOBERT = CBA.CODCOBERT
INNER JOIN REGLA_SA_COBER RSA ON RSA.CODCOBERT= CBA.CODCOBERT AND RSA.IDPOLIZA = CBA.IDPOLIZA AND RSA.IDETPOL = CBA.IDETPOL
AND CS.PLANCOB = CBA.PLANCOB
AND CS.IDTIPOSEG = CBA.IDTIPOSEG
AND CS.CODEMPRESA = CBA.CODEMPRESA
AND CS.CODCIA = CBA.CODCIA
AND CBA.CODCIA = $P{CODCIA} 
AND CBA.IDPOLIZA = $P{IDPOLIZA} 
AND CBA.IDETPOL = $P{IDETPOL} 
AND CBA.COD_ASEGURADO = $P{COD_ASEGURADO} 
UNION
SELECT CBA.CODCIA, CBA.COD_ASEGURADO, CBA.CODEMPRESA, CBA.IDPOLIZA, CBA.IDETPOL, CBA.CODCOBERT, CBA.PLANCOB, CBA.IDTIPOSEG, 
RSA.TEXTO SUMAASEG_MONEDA,
RSA.TEXTO AS SUMAASEG_LOCAL,
CBA.PRIMA_MONEDA, CBA.PRIMA_LOCAL, DEDUCIBLE_LOCAL,
OC_COBERTURAS_DE_SEGUROS.DESCRIPCION_COBERTURA(CBA.CODCIA, CBA.CODEMPRESA, CBA.IDTIPOSEG, CBA.PLANCOB, CBA.CODCOBERT) NOMBRECOBERTURA, ORDENIMPRESION
FROM COBERT_ACT CBA 
INNER JOIN COBERTURAS_DE_SEGUROS CS ON CS.CODCOBERT = CBA.CODCOBERT
INNER JOIN REGLA_SA_COBER RSA ON RSA.CODCOBERT= CBA.CODCOBERT AND RSA.IDPOLIZA = CBA.IDPOLIZA AND RSA.IDETPOL = CBA.IDETPOL
AND CS.PLANCOB = CBA.PLANCOB
AND CS.IDTIPOSEG = CBA.IDTIPOSEG
AND CS.CODEMPRESA = CBA.CODEMPRESA
AND CS.CODCIA = CBA.CODCIA
AND CBA.CODCIA = $P{CODCIA} 
AND CBA.IDPOLIZA = $P{IDPOLIZA} 
AND CBA.IDETPOL = $P{IDETPOL} 
AND CBA.COD_ASEGURADO = $P{COD_ASEGURADO} 
ORDER BY ORDENIMPRESION]]>
		</queryString>
